*[Cc]ache*
*.log
*backup*
*~
build
restic-ignore

$HOME/.atuin
$HOME/.duckdb
$HOME/.librewolf
$HOME/.mozilla
$HOME/.local/opt
$HOME/.ollama
$HOME/.pki
$HOME/.steam

$XDG_DATA_HOME/*

!$XDG_DATA_HOME/applications
!$XDG_DATA_HOME/cargo
!$XDG_DATA_HOME/dbus-1
!$XDG_DATA_HOME/easyeffects
!$XDG_DATA_HOME/fonts
!$XDG_DATA_HOME/gnupg
!$XDG_DATA_HOME/icons
!$XDG_DATA_HOME/kwalletd
!$XDG_DATA_HOME/nautilus-python
!$XDG_DATA_HOME/opensnitch
!$XDG_DATA_HOME/zsh

$XDG_STATE_HOME/*

!$XDG_STATE_HOME/noctalia

  $XDG_STATE_HOME/noctalia/*
  !$XDG_STATE_HOME/noctalia/settings.toml
